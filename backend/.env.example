# ==============================================================================
# Finora Backend — Variables d'environnement (EXEMPLE UNIQUEMENT)
# Copiez ce fichier vers .env et remplacez les valeurs par vos propres secrets.
# Ne publiez jamais votre fichier .env sur GitHub.
# ==============================================================================

# Local : mongodb://localhost:27017/
# Production (MongoDB Atlas) : mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=choaib

# Clé secrète JWT (utilisez au moins 32 caractères aléatoires en production)
JWT_SECRET=remplacez_par_une_cle_secrete_aleatoire_de_32_caracteres_minimum
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Origines autorisées par CORS (séparées par des virgules)
# Exemple production : https://finora.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
